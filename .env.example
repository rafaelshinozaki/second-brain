# ==========================================================================
# AI Second Brain — environment variables. Copy to .env and adjust.
# The real .env is git-ignored and should be chmod 600.
#   cp .env.example .env      (setup.sh does this and generates a password)
# ==========================================================================

# --- Neo4j -----------------------------------------------------------------
NEO4J_USER=neo4j
# Generate a strong one:  openssl rand -base64 24
NEO4J_PASSWORD=change_me_please

# --- Default knowledge group -----------------------------------------------
GRAPHITI_GROUP_ID=global

# --- Concurrency (keep low for local Ollama on CPU) ------------------------
SEMAPHORE_LIMIT=2

# --- Extraction temperature (0 = deterministic; required by Anthropic) -----
LLM_TEMPERATURE=0

# --- Dual extraction (only matters when LLM_PROVIDER is a cloud model) -----
# Fewer than THRESHOLD episodes in WINDOW seconds -> local Ollama (free).
# THRESHOLD or more -> the paid LLM_PROVIDER above. Embeddings stay local.
EXTRACTION_PAID_THRESHOLD=5
EXTRACTION_BURST_WINDOW_SEC=8
OLLAMA_MODEL_NAME=qwen2.5-brain
OLLAMA_API_URL=http://host.docker.internal:11434/v1

# ==========================================================================
# EXTRACTION MODEL — pick ONE block. Default = LOCAL Ollama (no API key).
# Embeddings stay LOCAL and free in every case (see the Embeddings block).
# After changing this, run:  docker compose up -d
# ==========================================================================

# --- OPTION A: Local Ollama (default, free) --------------------------------
LLM_PROVIDER=openai
MODEL_NAME=qwen2.5-brain
LLM_STRUCTURED_OUTPUT_MODE=json_object
OPENAI_API_KEY=ollama
OPENAI_API_URL=http://host.docker.internal:11434/v1
# The image ignores the config's LLM api_url, so the OpenAI SDK reads THIS var.
# Keep it equal to OPENAI_API_URL. (This is why we also set it here.)
OPENAI_BASE_URL=http://host.docker.internal:11434/v1

# --- OPTION B: Google Gemini (fast, cheap; free tier ~10 req/min) ----------
# Uses Gemini's OpenAI-compatible endpoint (no google-genai needed).
# NOTE: on the free tier add memories gradually — a burst hits the per-minute
# quota (429). For the true free tier, create an AI Studio project WITHOUT
# billing (a project with billing is charged, not free).
# LLM_PROVIDER=openai
# MODEL_NAME=gemini-2.5-flash
# LLM_STRUCTURED_OUTPUT_MODE=json_object
# OPENAI_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY
# OPENAI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- OPTION C: Anthropic Claude (best dedup; native provider) --------------
# Requires the built image (default `docker compose up -d --build`) — it bundles
# the Anthropic SDK. Uses the NATIVE anthropic provider (the OpenAI-compat
# endpoint does NOT work — it demands response_format.json_schema.strict).
# LLM_PROVIDER=anthropic
# MODEL_NAME=claude-haiku-4-5
# ANTHROPIC_API_KEY=sk-ant-...
# (leave OPENAI_* above pointing at Ollama — the embedder still uses them.)

# --- OPTION D: OpenAI --------------------------------------------------------
# LLM_PROVIDER=openai
# MODEL_NAME=gpt-4.1-mini
# LLM_STRUCTURED_OUTPUT_MODE=json_object
# OPENAI_API_KEY=sk-...
# OPENAI_API_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Embeddings (LOCAL Ollama, free — leave as-is for every option above) --
EMBEDDER_PROVIDER=openai
EMBEDDER_MODEL=nomic-embed-text
EMBEDDER_DIMENSIONS=768
EMBEDDER_API_URL=http://host.docker.internal:11434/v1
